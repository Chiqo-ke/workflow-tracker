SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Use 'sqlite' for local development, leave unset or 'postgresql' for production
DB_ENGINE=sqlite

# PostgreSQL settings (only used when DB_ENGINE=postgresql)
DB_NAME=workflow_tracker
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432